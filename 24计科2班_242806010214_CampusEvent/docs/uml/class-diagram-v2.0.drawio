/><mxCell id="1" parent="0"/><mxCell id="cr01_title" value="CR-01 视图：年级限定直接报名（策略选择与拒绝）" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="30" as="geometry"/></mxCell><mxCell id="cr01_service" value="&lt;b&gt;RegistrationService&lt;/b&gt;&lt;hr&gt;- policy_provider: PolicyProvider&lt;hr&gt;+ submit(student_id, activity_id): Registration" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="300" height="150" as="geometry"/></mxCell><mxCell id="cr01_provider" value="&lt;i&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/i&gt;&lt;br&gt;&lt;b&gt;PolicyProvider&lt;/b&gt;&lt;hr&gt;+ get(activity): RegistrationPolicy" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="240" height="90" as="geometry"/></mxCell><mxCell id="cr01_registry" value="&lt;b&gt;PolicyRegistry&lt;/b&gt;&lt;hr&gt;- policies: dict&lt;br&gt;- grade_limited_policy&lt;hr&gt;+ get(activity): RegistrationPolicy" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="200" width="240" height="100" as="geometry"/></mxCell><mxCell id="cr01_policy" value="&lt;i&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/i&gt;&lt;br&gt;&lt;b&gt;RegistrationPolicy&lt;/b&gt;&lt;hr&gt;+ decide(activity, student): RegistrationStatus" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="760" y="80" width="240" height="90" as="geometry"/></mxCell><mxCell id="cr01_direct" value="&lt;b&gt;DirectRegistrationPolicy&lt;/b&gt;&lt;hr&gt;+ decide(activity, student): RegistrationStatus" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="720" y="220" width="200" height="80" as="geometry"/></mxCell><mxCell id="cr01_audit" value="&lt;b&gt;AuditRegistrationPolicy&lt;/b&gt;&lt;hr&gt;+ decide(activity, student): RegistrationStatus" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="720" y="330" width="200" height="80" as="geometry"/></mxCell><mxCell id="cr01_grade" value="&lt;b&gt;GradeLimitedDirectPolicy&lt;/b&gt;&lt;hr&gt;- inner: DirectRegistrationPolicy&lt;hr&gt;+ decide(activity, student): RegistrationStatus" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="980" y="220" width="260" height="100" as="geometry"/></mxCell><mxCell id="cr01_error" value="&lt;b&gt;PolicyRejectedError&lt;/b&gt;&lt;hr&gt;- message: str" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="980" y="370" width="240" height="70" as="geometry"/></mxCell><mxCell id="cr01_note" value="选择规则：activity.policy_type=direct 且 grade_limited=1 → GradeLimitedDirectPolicy；其余按 policy_type 返回原策略。GradeLimitedDirectPolicy 先校验 grade∈{2,3}，再委托 DirectRegistrationPolicy；不满足抛 PolicyRejectedError，报名不创建。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="600" height="100" as="geometry"/></mxCell><mxCell id="cr01_e1" value="" style="endArrow=open;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="cr01_service" target="cr01_provider"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr01_e2" value="" style="endArrow=block;endFill=0;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="cr01_registry" target="cr01_provider"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr01_e3" value="" style="endArrow=open;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="cr01_registry" target="cr01_policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr01_e4" value="" style="endArrow=block;endFill=0;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="cr01_direct" target="cr01_policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr01_e5" value="" style="endArrow=block;endFill=0;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="cr01_audit" target="cr01_policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr01_e6" value="" style="endArrow=block;endFill=0;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="cr01_grade" target="cr01_policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr01_e7" value="" style="endArrow=open;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="cr01_grade" target="cr01_direct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr01_e8" value="" style="endArrow=open;dashed=1;html=1;strokeColor=#b85450;" edge="1" parent="1" source="cr01_grade" target="cr01_error"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cr02" name="CR-02 邮件通知"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cr02_title" value="CR-02 视图：模拟邮件通知（观察者 + 日志 + 失败不滚回）" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="760" height="30" as="geometry"/></mxCell><mxCell id="cr02_publisher" value="&lt;b&gt;RegistrationEventPublisher&lt;/b&gt;&lt;hr&gt;- observers: list&lt;hr&gt;+ subscribe(observer): void&lt;br&gt;+ publish(event): void" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="300" height="110" as="geometry"/></mxCell><mxCell id="cr02_observer" value="&lt;i&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/i&gt;&lt;br&gt;&lt;b&gt;RegistrationObserver&lt;/b&gt;&lt;hr&gt;+ on_registration_event(event): void" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="250" height="90" as="geometry"/></mxCell><mxCell id="cr02_msgobs" value="&lt;b&gt;MessageObserver&lt;/b&gt;&lt;hr&gt;- message_repo: MessageRepository&lt;hr&gt;+ on_registration_event(event): void" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="440" y="240" width="240" height="100" as="geometry"/></mxCell><mxCell id="cr02_emailobs" value="&lt;b&gt;EmailObserver&lt;/b&gt;&lt;hr&gt;- email_sender: MockEmailSender&lt;br&gt;- email_repo: EmailLogRepository&lt;hr&gt;+ on_registration_event(event): void" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="760" y="220" width="300" height="130" as="geometry"/></mxCell><mxCell id="cr02_sender" value="&lt;b&gt;MockEmailSender&lt;/b&gt;&lt;hr&gt;+ send(recipient, subject, content): void" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1120" y="220" width="250" height="100" as="geometry"/></mxCell><mxCell id="cr02_repo" value="&lt;i&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/i&gt;&lt;br&gt;&lt;b&gt;EmailLogRepository&lt;/b&gt;&lt;hr&gt;+ save(log): void&lt;br&gt;+ find_by_event_key(key): EmailLog&lt;br&gt;+ list(): list" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="760" y="430" width="260" height="100" as="geometry"/></mxCell><mxCell id="cr02_log" value="&lt;b&gt;EmailLog&lt;/b&gt;&lt;hr&gt;- log_id: str&lt;br&gt;- registration_id: str&lt;br&gt;- event_type: str&lt;br&gt;- recipient: str&lt;br&gt;- subject/content: str&lt;br&gt;- status: SENT/FAILED&lt;br&gt;- error: str&lt;br&gt;- created_at: datetime&lt;br&gt;- event_key: str (unique)" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1100" y="400" width="260" height="160" as="geometry"/></mxCell><mxCell id="cr02_note" value="语义：MessageObserver 先、EmailObserver 后；站内失败仍回滚（Q-04），邮件失败由 EmailObserver 捕获并写 FAILED，不抛异常、不回滚；event_key 唯一防重复。收件人 student_id@campus.demo。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="640" height="100" as="geometry"/></mxCell><mxCell id="cr02_e1" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="cr02_publisher" target="cr02_observer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr02_e2" value="" style="endArrow=block;endFill=0;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="cr02_msgobs" target="cr02_observer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr02_e3" value="" style="endArrow=block;endFill=0;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="cr02_emailobs" target="cr02_observer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr02_e4" value="" style="endArrow=open;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="cr02_emailobs" target="cr02_sender"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr02_e5" value="" style="endArrow=open;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="cr02_emailobs" target="cr02_repo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr02_e7" value="" style="endArrow=open;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="cr02_repo" target="cr02_log"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>