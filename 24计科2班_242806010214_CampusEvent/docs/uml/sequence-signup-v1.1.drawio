66;exitX=0.5;exitY=0.1172;entryX=0.5;entryY=0.1172;" edge="1" parent="1" source="ll_student_repo" target="ll_service"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m4" value="find_by_id(activity_id)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=0.1484;entryX=0.5;entryY=0.1484;" edge="1" parent="1" source="ll_service" target="ll_activity_repo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m5" value="Activity" style="html=1;endArrow=open;dashed=1;strokeColor=#666666;exitX=0.5;exitY=0.1719;entryX=0.5;entryY=0.1719;" edge="1" parent="1" source="ll_activity_repo" target="ll_service"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m6" value="find_active(student_id, activity_id)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=0.2031;entryX=0.5;entryY=0.2031;" edge="1" parent="1" source="ll_service" target="ll_reg_repo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m7" value="None" style="html=1;endArrow=open;dashed=1;strokeColor=#666666;exitX=0.5;exitY=0.2266;entryX=0.5;entryY=0.2266;" edge="1" parent="1" source="ll_reg_repo" target="ll_service"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m8" value="get(policy_type)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=0.2578;entryX=0.5;entryY=0.2578;" edge="1" parent="1" source="ll_service" target="ll_registry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m9" value="policy" style="html=1;endArrow=open;dashed=1;strokeColor=#666666;exitX=0.5;exitY=0.2813;entryX=0.5;entryY=0.2813;" edge="1" parent="1" source="ll_registry" target="ll_service"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m10" value="decide(activity)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=0.3125;entryX=0.5;entryY=0.3125;" edge="1" parent="1" source="ll_service" target="ll_policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m11" value="APPROVED / PENDING" style="html=1;endArrow=open;dashed=1;strokeColor=#666666;exitX=0.5;exitY=0.3359;entryX=0.5;entryY=0.3359;" edge="1" parent="1" source="ll_policy" target="ll_service"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m12" value="ensure_available(activity_id)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=0.3906;entryX=0.5;entryY=0.3906;" edge="1" parent="1" source="ll_service" target="ll_capacity"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m13" value="count_approved(activity_id)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=0.4141;entryX=0.5;entryY=0.4141;" edge="1" parent="1" source="ll_capacity" target="ll_reg_repo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m14" value="count" style="html=1;endArrow=open;dashed=1;strokeColor=#666666;exitX=0.5;exitY=0.4375;entryX=0.5;entryY=0.4375;" edge="1" parent="1" source="ll_reg_repo" target="ll_capacity"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m15" value="ok（count &lt; capacity）" style="html=1;endArrow=open;dashed=1;strokeColor=#666666;exitX=0.5;exitY=0.4609;entryX=0.5;entryY=0.4609;" edge="1" parent="1" source="ll_capacity" target="ll_service"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m16" value="raise 满员" style="html=1;endArrow=open;dashed=1;strokeColor=#b85450;exitX=0.5;exitY=0.5000;entryX=0.5;entryY=0.5000;" edge="1" parent="1" source="ll_capacity" target="ll_service"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m17" value="报名失败（名额已满）" style="html=1;endArrow=open;dashed=1;strokeColor=#b85450;exitX=0.5;exitY=0.5234;entryX=0.5;entryY=0.5234;" edge="1" parent="1" source="ll_service" target="ll_student"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m18" value="save(Registration APPROVED)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=0.5781;entryX=0.5;entryY=0.5781;" edge="1" parent="1" source=