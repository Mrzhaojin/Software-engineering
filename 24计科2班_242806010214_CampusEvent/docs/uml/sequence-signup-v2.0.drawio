lue="sent" style="html=1;endArrow=open;dashed=1;strokeColor=#666666;exitX=0.5;exitY=0.7797;entryX=0.5;entryY=0.7797;" edge="1" parent="1" source="s_sender" target="s_email"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m21" value="save(EmailLog SENT)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=0.8051;entryX=0.5;entryY=0.8051;" edge="1" parent="1" source="s_email" target="s_log"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m22" value="send(...) 失败" style="html=1;endArrow=open;dashed=1;strokeColor=#b85450;exitX=0.5;exitY=0.8390;entryX=0.5;entryY=0.8390;" edge="1" parent="1" source="s_email" target="s_sender"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m23" value="save(EmailLog FAILED, error)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=0.8644;entryX=0.5;entryY=0.8644;" edge="1" parent="1" source="s_email" target="s_log"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m24" value="Registration（成功）" style="html=1;endArrow=open;dashed=1;strokeColor=#666666;exitX=0.5;exitY=0.9492;entryX=0.5;entryY=0.9492;" edge="1" parent="1" source="s_service" target="s_student"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l_no" value="[年级不符]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="210" y="265" width="150" height="20" as="geometry"/></mxCell><mxCell id="l_ok" value="[grade∈{2,3}]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="210" y="360" width="150" height="20" as="geometry"/></mxCell><mxCell id="l_es" value="[邮件成功]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1410" y="905" width="150" height="20" as="geometry"/></mxCell><mxCell id="l_ef" value="[邮件失败]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1410" y="1010" width="150" height="20" as="geometry"/></mxCell><mxCell id="note" value="年级不符：PolicyRejectedError 使报名不创建；名额/开始时间/重复报名公共约束不变。通知顺序：MessageObserver 先（事务内，失败回滚），EmailObserver 后（失败捕获、写 FAILED、不回滚，CR2-03）。event_key 唯一防重复。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="1100" height="60" as="geometry"/></mxCell><mxCell id="ver" value="版本：v2.0 | 日期：2026-11-26 | 基线：baseline-v1 | 分支：change-v2 | 依据：CR-01/CR-02、类模型 v2.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1500" y="1220" width="450" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>